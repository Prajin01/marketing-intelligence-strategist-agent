# --- LLM Provider ---
# DISCLOSURE: The assignment specifies Claude as the required LLM. This
# project defaults to Claude ("anthropic"). A free, open-weight alternative
# ("groq") is also supported below for development/demo purposes when API
# budget isn't available — this is a documented, disclosed substitution,
# not a silent swap. See README for the full explanation.
# Set to "anthropic" (default, required by the assignment) or "groq" (free).
LLM_PROVIDER=anthropic

# --- Claude API (used when LLM_PROVIDER=anthropic) ---
# Get a key from https://console.anthropic.com/
ANTHROPIC_API_KEY=your_api_key_here

# Model used for most pipeline stages (planning, extraction, per-dimension analysis).
# Good balance of speed/cost/quality for a multi-call pipeline.
ANTHROPIC_MODEL=claude-sonnet-5

# Optional: a stronger model used only for the final strategy-generation step,
# where deeper reasoning over the full analysis matters more than latency.
# Leave blank to just reuse ANTHROPIC_MODEL everywhere.
ANTHROPIC_STRATEGY_MODEL=claude-opus-5

# --- Groq API (used when LLM_PROVIDER=groq) ---
# Free, no card required: https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here

# Groq's current recommended general-purpose open-weight model.
GROQ_MODEL=llama-3.3-70b-versatile

# Optional: leave blank to reuse GROQ_MODEL for the strategy step too.
GROQ_STRATEGY_MODEL=

# --- Research behaviour ---
# Max competitors that get fully fetched + analyzed (discovery may find more; this
# caps how many go through deep research to keep runtime/cost bounded for a live demo).
MAX_COMPETITORS=6

# Per-domain delay between requests, in seconds. Keep this polite.
REQUEST_DELAY_SECONDS=1.5

# HTTP request timeout, in seconds.
REQUEST_TIMEOUT_SECONDS=10

# Identify the tool honestly in the User-Agent (edit the contact info before running).
USER_AGENT=MarketingIntelligenceAgent/0.1 (internship project; contact: you@example.com)

# --- Storage ---
DATA_DIR=data

# --- Logging ---
LOG_LEVEL=INFO